# URL du backend Sinaps pour l'application mobile
# Android Émulateur : http://10.0.2.2:5000/api
# iOS Simulateur / Web : http://localhost:5000/api
# Smartphone Physique : http://<IP_LOCALE_ORDINATEUR>:5000/api (ex: http://192.168.1.50:5000/api)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Create one OAuth client for each platform in Google Cloud Console.
# Android must match applicationId com.sinaps.support and its SHA-1 certificate.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
