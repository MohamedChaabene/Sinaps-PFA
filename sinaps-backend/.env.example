PORT=5000
NODE_ENV=development

# MongoDB connection URI (MongoDB Atlas recommended for production)
# Leave empty to use local MongoDB (127.0.0.1:27017/sinaps) or in-memory fallback
MONGO_URI=

# JWT secret — MUST be a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Gemini AI API key — get one at https://aistudio.google.com/
GEMINI_API_KEY=

# Google OAuth client ID(s) allowed to sign in.
# Accepts a comma-separated list for Android, iOS, and web clients.
# GOOGLE_CLIENT_ID is also accepted for a single-client setup.
GOOGLE_CLIENT_IDS=

# CORS: allowed origins for the frontend
# Example: https://sinaps.vercel.app
CLIENT_ORIGIN=
CLIENT_URL=

# Maximum file upload size in megabytes (default: 15)
MAX_UPLOAD_SIZE_MB=15
