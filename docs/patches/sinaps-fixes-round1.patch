diff --git a/sinaps-backend/middleware/auth.js b/sinaps-backend/middleware/auth.js
index 84e8bbc..12cbec9 100644
--- a/sinaps-backend/middleware/auth.js
+++ b/sinaps-backend/middleware/auth.js
@@ -19,4 +19,20 @@ function requireAdmin(req, res, next) {
   next();
 }
 
-module.exports = { requireAuth, requireAdmin };
\ No newline at end of file
+function requireAgentOrAdmin(req, res, next) {
+  if (req.agent.role !== 'agent' && req.agent.role !== 'admin') {
+    return res.status(403).json({ error: 'Accès réservé aux agents de support' });
+  }
+  next();
+}
+
+// Anyone could previously POST /api/messages with sender: 'humain' and no
+// credentials at all, impersonating a support agent in any conversation.
+// This only enforces a JWT + agent/admin role when the message claims to be
+// from a human agent; client-authored messages are unaffected.
+function requireAgentForHumanSender(req, res, next) {
+  if (req.body?.sender !== 'humain') return next();
+  return requireAuth(req, res, () => requireAgentOrAdmin(req, res, next));
+}
+
+module.exports = { requireAuth, requireAdmin, requireAgentOrAdmin, requireAgentForHumanSender };
\ No newline at end of file
